# Copiar a .env y rellenar valores. No subir .env al repositorio.
SECRET_KEY=dev-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# PostgreSQL (Supabase o Render). En local con SQLite puedes omitir o usar:
# DATABASE_URL=sqlite:///./db.sqlite3
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Cloudflare R2 (almacenamiento de fotos). Obligatorio en produccion: el disco de Render es efimero.
# En local, si se omiten, se usa disco local.
# El endpoint tiene la forma https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
